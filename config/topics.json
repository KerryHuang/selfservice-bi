          "sql": "b.qty"
        },
        {
          "id": "unit",
          "label": "單位",
          "type": "enum",
          "grp": "main",
          "kind": "unit",
          "sql": "b.unit"
        },
        {
          "id": "currency",
          "label": "幣別",
          "type": "enum",
          "grp": "main",
          "sql": "a.currency"
        },
        {
          "id": "qcCheck",
          "label": "品管",
          "type": "enum",
          "grp": "main",
          "sql": "b.qc_result"
        }
      ]
    }
  }
