          "sql": "b.part_name"
        },
        {
          "id": "toolNo",
          "label": "工模號",
          "type": "text",
          "grp": "main",
          "sql": "b.tool_no"
        },
        {
          "id": "jobNo",
          "label": "工令",
          "type": "text",
          "grp": "main",
          "sql": "b.job_no"
        },
        {
          "id": "qty",
          "label": "收料數量",
          "type": "number",
          "grp": "main",
